# ── Database (same Supabase project, two databases) ─────────────────────────
# Local + Vercel Preview (dev branch) → crustory_dev
# Vercel Production (main branch)     → postgres
#
# Host/user/password are the same; only the database name differs.
#
# Local / Preview (dev):
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/crustory_dev?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/crustory_dev"
#
# Production (main) — set in Vercel Production env only:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"
CUSTOMER_SESSION_SECRET="change-me-to-another-long-random-string"
# Local. On Vercel: Production=https://crustory.co.kr, Preview=dev branch URL (or omit — request Host wins)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Localhost auto-login bypass. Set 0 to disable, 1 to force even off localhost.
# AUTH_BYPASS="0"
NEXT_PUBLIC_GTM_ID="GTM-KWHFXFGS"

# Google Analytics 4 (admin /visitors)
# Property ID: GA 관리 > 속성 설정 > 속성 ID (숫자)
GA4_PROPERTY_ID=""
# 서비스 계정 JSON (Analytics Data API Viewer). 없으면 FIREBASE_SERVICE_ACCOUNT_JSON 재사용
# GA_SERVICE_ACCOUNT_JSON=""

# Kakao Login (https://developers.kakao.com)
# Redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/kakao/callback
KAKAO_REST_API_KEY=""
KAKAO_CLIENT_SECRET=""

# Firebase Cloud Messaging (server) — Android 앱 푸시
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 JSON 내용을 한 줄로 넣거나 경로 사용
FIREBASE_SERVICE_ACCOUNT_JSON=""
