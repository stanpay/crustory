# Supabase Postgres (Transaction pooler — Vercel/serverless)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler (migrations / Prisma CLI) — direct host may fail without IPv4
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

ADMIN_EMAIL="admin@crustory.com"
ADMIN_PASSWORD="crustoryadmin"
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"
CUSTOMER_SESSION_SECRET="change-me-to-another-long-random-string"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GA_ID=""

# Kakao Login (https://developers.kakao.com)
# Redirect URI: {NEXT_PUBLIC_SITE_URL}/api/auth/kakao/callback
KAKAO_REST_API_KEY=""
KAKAO_CLIENT_SECRET=""

# Firebase Cloud Messaging (server) — Android 앱 푸시
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 JSON 내용을 한 줄로 넣거나 경로 사용
FIREBASE_SERVICE_ACCOUNT_JSON=""
