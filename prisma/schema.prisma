generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SaleType {
  NORMAL
  PREORDER
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  SHIPPED
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  runieNote   String   @default("") // legacy; prefer detailHtml
  detailHtml  String   @default("") // PDP 커스텀 상세 HTML
  detailCss   String   @default("") // PDP 커스텀 상세 CSS
  price       Int
  stock       Int      @default(0)
  images      String // JSON array of image paths
  saleType    SaleType @default(NORMAL)
  options     String   @default("[]") // JSON
  category    String   @default("goods")
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

model Customer {
  id           String       @id @default(cuid())
  kakaoId      String       @unique
  email        String?
  name         String?
  profileImage String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  orders       Order[]
  pushDevices  PushDevice[]
}

model PushDevice {
  id         String    @id @default(cuid())
  token      String    @unique
  platform   String    @default("android")
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderId         String      @unique
  status          OrderStatus @default(PENDING)
  amount          Int
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  shippingMemo    String?
  paymentKey      String?
  isGuest         Boolean     @default(true)
  userId          String?
  user            Customer?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  price     Int
  quantity  Int
  option    String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model AdminUser {
  id        String   @id @default(cuid())
  kakaoId   String   @unique
  email     String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  body      String
  linkHref  String?
  linkLabel String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
